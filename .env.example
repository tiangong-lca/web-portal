# Production publishes from https://www.tiangong.earth (apex and portal.tiangong.earth redirect to it);
# keep this loopback value for local and CI fixtures.
SITE_URL=http://localhost:3000
PORTAL_PUBLIC_INDEXING=disabled
PORTAL_SITEMAP_CACHE_MODE=no-store
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORTAL_SUPABASE_TIMEOUT_MS=8000
PORTAL_EDGE_ENDPOINT=
PORTAL_EDGE_KEY_ID=
PORTAL_EDGE_HMAC_SECRET=
PORTAL_EDGE_TIMEOUT_MS=8000
PORTAL_HYBRID_EDGE_TIMEOUT_MS=30000
PORTAL_LIGHT_PRIMARY="#5C246A"
PORTAL_DARK_PRIMARY="#9E3FFD"
PORTAL_BRAND_VERSION=default-v1
PORTAL_LIGHT_LOGO=/brand/logo.svg
PORTAL_DARK_LOGO=/brand/logo-dark.svg
PORTAL_LOGO_MARK=
PORTAL_FAVICON=/brand/favicon.ico
PORTAL_LOGO_ALT_ZH=天工 LCA
PORTAL_LOGO_ALT_EN=TianGong LCA
PORTAL_LOGO_ALT_DE=TianGong LCA
PORTAL_LOGO_ALT_FR=TianGong LCA
PORTAL_LOGO_WIDTH=170.08
PORTAL_LOGO_HEIGHT=170.08
PORTAL_BRAND_ASSET_ORIGIN=
PORTAL_DEPLOYMENT_ENV=local
# Optional fallback for source archives without Git metadata; Git deployments inject exact HEAD.
PORTAL_DEPLOYMENT_SHA=local
PORTAL_CSP_MODE=report-only
# `performance` keeps ISR/CDN caching and permits only the inline scripts/styles required by Next.
# `strict` is the retained no-inline compatibility probe and is not the public EdgeOne profile.
PORTAL_CSP_PROFILE=performance
PORTAL_EXPECT_STRICT_CSP=0
R0_COMPAT_EDGE_ENDPOINT=
R0_COMPAT_KEY_ID=
R0_COMPAT_HMAC_SECRET=
